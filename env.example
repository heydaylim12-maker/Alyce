# Vercel 프로젝트 > Settings > Environment Variables 에 아래 값을 등록하세요.
# 이 파일에는 실제 키를 적지 말고, 깃허브에도 올리지 마세요.

# 필수: Anthropic Console(https://console.anthropic.com)에서 발급한 API 키
ANTHROPIC_API_KEY=sk-ant-...

# 권장: 수업 코드. 설정하면 이 코드를 아는 학생만 AI 코치를 쓸 수 있어요.
ACCESS_CODE=class2026

# 선택: 사용할 모델 (비워 두면 기본값)
# MODEL_DEFAULT=claude-sonnet-5-5
# MODEL_QUICK=claude-haiku-5-5

# 선택: IP 하나가 10분 동안 보낼 수 있는 요청 수 (기본 60)
# RATE_LIMIT_PER_10MIN=60
